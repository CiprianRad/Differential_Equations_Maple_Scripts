
with(DETools);
ecdif1 := diff(x(t), t) = x(t) + 4*y(t);
ecdif2 := diff(y(t), t) = x(t) + y(t);
sist := ecdif1, ecdif2;
sol := dsolve({sist}, {x(t), y(t)});
xx := unapply(rhs(sol[1]), t, c__1, c__2);
yy := unapply(rhs(sol[2]), t, c__1, c__2);
plot([xx(t, 1, 1), yy(t, 1, 1)], t = -10 .. 10, color = [red, blue]);
restart;
with(DETools);
ecdif1 := diff(x(t), t) = 2*x(t) - y(t);
ecdif2 := diff(y(t), t) = x(t) + 2*y(t);

with(DETools);
ecdif1 := diff(x(t), t) = x(t) - y(t) + z(t);
ecdif2 := diff(y(t), t) = x(t) + y(t) - z(t);
ecdif3 := diff(z(t), t) = -y(t) + 2*z(t);
sist := ecdif1, ecdif2, ecdif3;
sol := dsolve({sist}, {x(t), y(t), z(t)});
xx := unapply(rhs(sol[1]), t, c__1, c__2, c__3);
yy := unapply(rhs(sol[2]), t, c__1, c__2, c__3);
zz := unapply(rhs(sol[3]), t, c__1, c__2, c__3);
plot([xx(t, 1, 1, 1), yy(t, 1, 1, 1), zz(t, 1, 1, 1)], t = -5 .. 5, color = [red, blue, green]);
restart;
with(DETools);
ecdif1 := diff(x(t), t) = 5*x(t) + 3*y(t) + 1;


with(DETools);
ecdif := diff(x(t), t) = -k*x(t);
cond_in := x(0) = x__0;
soll := dsolve({cond_in, ecdif}, x(t));
y1 := unapply(rhs(soll), x__0, k, t);
plot([y1(2, 4, t), y1(1, 1, t), y1(0, 1, t), y1(1, 0, t)], t = -1 .. 1, color = [black, red, blue, green]);
solve(x__0/2 = y1(x__0, k, t), t);
evalf(solve(x__0/2 = y1(x__0, k, 5730), k));
k1 := solve(0.9 = y1(3, k, 2), k);
T__1__2 := evalf(ln(2)/k1);
NULL;
restart;
with(DETools);
ecdiff := diff(T(t), t) = -k*(T(t) - T__m);
cond_in := T(0) = T__0;
soll := dsolve({cond_in, ecdiff}, T(t));
y1 := unapply(rhs(soll), t, k, T__0, T__m);
plot([y1(t, 2, 1, 3), y1(t, 3, 2, 2), y1(t, 5, 1, 1), y1(t, 2, 0, 1)], t = -2 .. 2, color = [black, red, blue, green]);
solve({y1(t, k, 36, 21) = 34.22, y1(t + 1, k, 36, 21) = 34.11}, {k, t});
restart;
with(DETools);
ecdif1 := diff(x(t), t) = r*x(t);
cond_in := x(0) = x__0;
ecdif2 := diff(x(t), t) = r__0*x(t)*(1 - x(t)/K);
soll1 := dsolve({cond_in, ecdif1}, x(t));
soll2 := dsolve({cond_in, ecdif2}, x(t));
y1 := unapply(rhs(soll1), x__0, r, t);
plot([y1(10, -3, t), y1(10, 3, t), y1(100, -5, t), y1(100, 5, t)], t = -1 .. 1, color = [black, red, blue, green]);
y2 := unapply(rhs(soll2), K, x__0, r__0, t);
plot([y2(1000, 200, 10, t), y2(1000, 200, -10, t), y2(500, 10, 20, t), y2(500, 10, -20, t)], t = -10 .. 10, color = [blue, red, green, yellow]);
rt := solve({y1(9.6*10^6, r, t) = 9.6*10^6, y1(9.6*10^6, r, t + 10) = 12.9*10^6}, {r, t});
r1 := rhs(rt[1]);
evalf(y1(9.6*10^6, r1, 110));
rt1 := solve({y2(K, 9.6*10^6, r__0, t) = 9.6*10^6, y2(K, 9.6*10^6, r__0, t + 10) = 12.9*10^6, y2(K, 9.6*10^6, r__0, t + 20) = 17.1*10^6}, {K, r__0, t});
K1 := rhs(rt1[1]);
r2 := rhs(rt1[2]);
evalf(y2(K1, 9.6*10^6, r2, 110));
NULL;

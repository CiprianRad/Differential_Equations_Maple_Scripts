
with(DETools);
ecdif1 := diff(y(x), x) = 2*x*(1 + y(x)^2);
soll := dsolve(ecdif1, y(x));
y1 := unapply(rhs(soll), x, c__1);
plot(y1(x, 5), x = -10 .. 10);
restart;
with(DETools);
ecdif := (x^2 - 1)*diff(y(x), x) + 2*x*y(x)^2 = 0;
soll := dsolve(ecdif, y(x));
y1 := unapply(rhs(soll), x, c__1);
plot([y1(x, 5), y1(x, 0), y1(x, 1)], x = 3 .. 10, color = [red, green, blue]);
restart;

with(DETools);
ecdif := diff(y(x), x) + k*y(x)/x = x^3;
soll := dsolve(ecdif, y(x));
ecdif2 := diff(y(x), x) + y(x)/x = x^3;
cond_in := y(1) = 1, y(1) = 2, y(1) = 3, y(1) = 4, y(1) = 5, y(1) = -1, y(1) = -2, y(1) = -3, y(1) = -4, y(1) = -5, y(1) = 0, y(1) = (-2)/5;
DEplot([ecdif2], [y(x)], x = 0.1 .. 0.5, [cond_in], arrows = medium, linecolor = blue, stepsize = 0.1);

